{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/deny_dangerous.mjs\"" }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/comment_lint_hook.mjs\"" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/wgsl_hook.mjs\"" },
          { "type": "command", "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hooks/test_shape_hook.mjs\"" }
        ]
      }
    ]
  }
}
